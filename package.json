{
  "name": "opencode2-enhanced-composer",
  "version": "0.1.0",
  "description": "Enhanced Composer: configurable OpenCode 2 prompt status with location, token usage, cost, context, live throughput and an in-TUI settings editor",
  "license": "MIT",
  "author": "P-Theo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-Theo/opencode2-enhanced-composer.git"
  },
  "homepage": "https://github.com/P-Theo/opencode2-enhanced-composer#readme",
  "bugs": "https://github.com/P-Theo/opencode2-enhanced-composer/issues",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode2",
    "tui",
    "plugin",
    "tokens",
    "token-usage",
    "throughput",
    "tps",
    "footer",
    "composer"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "exports": {
    "./tui": "./dist/tui.js",
    "./options.schema.json": "./options.schema.json"
  },
  "files": [
    "dist",
    "options.schema.json"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/plugin": "2.0.15",
    "@opencode/theme": "2.0.15",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.10",
    "@oxlint/plugins": "^1.82.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "babel-preset-solid": "1.9.12",
    "oxlint": "^1.82.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "@opentui/solid": {
      "@babel/core": "^7.29.7"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "check:compatibility": "node scripts/check-compatibility.mjs",
    "lint": "oxlint",
    "test": "bun test",
    "prepack": "npm run lint && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "string-width": "7.2.0"
  }
}
