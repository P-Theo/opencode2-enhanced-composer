{
  "name": "opencode2-enhanced-composer",
  "version": "0.1.1-rc.1",
  "description": "Enhanced Composer: configurable OpenCode 2 prompt status with location, token usage, cost, context, live throughput and an in-TUI settings editor",
  "license": "MIT",
  "author": "P-Theo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-Theo/opencode2-enhanced-composer.git"
  },
  "homepage": "https://github.com/P-Theo/opencode2-enhanced-composer#readme",
  "bugs": "https://github.com/P-Theo/opencode2-enhanced-composer/issues",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode2",
    "tui",
    "plugin",
    "tokens",
    "token-usage",
    "throughput",
    "tps",
    "footer",
    "composer"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "exports": {
    "./tui": "./dist/tui.js",
    "./options.schema.json": "./options.schema.json"
  },
  "files": [
    "dist",
    "options.schema.json"
  ],
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/client": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "@opencode/theme": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@oxlint/plugins": "^1.94.0",
    "@types/bun": "1.4.4",
    "@types/node": "^26.0.0",
    "babel-preset-solid": "1.9.19",
    "oxlint": "^1.94.0",
    "solid-js": "1.9.19",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "glob@9 - 14.0.1": "14.0.6",
    "minimatch@7 - 11.0.0": "11.0.8"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "check:metadata": "node scripts/check-sdk-versions.mjs",
    "lint": "oxlint",
    "test": "bun test",
    "test:opencode": "python3 scripts/check-opencode.py",
    "prepack": "npm run lint && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "string-width": "7.2.0"
  }
}
